pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out Mediplus source code'
                checkout scm
            }
        }

       stage('Install Dependencies') {
    steps {
        echo 'Installing Mediplus dependencies'

        sh '''
        docker run --rm \
          -v "$WORKSPACE:/app" \
          -w /app \
          python:3.11-slim \
          sh -c "pip install -r requirements.txt"
        '''
    }
}

stage('Dependency Scan - pip-audit') {
    steps {
        echo 'Running pip-audit'

        sh '''
        docker run --rm \
          -v "$WORKSPACE:/app" \
          -w /app \
          python:3.11-slim \
          sh -c "pip install -r requirements.txt pip-audit && pip-audit"
        '''
    }
}

        stage('SAST - SonarQube') {
            steps {
                echo 'Running SonarQube analysis'
                echo 'SonarQube integration will be configured next'
            }
        }

        stage('DAST - OWASP ZAP') {
            steps {
                echo 'OWASP ZAP integration will be configured next'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Mediplus Docker image'
                sh 'docker build -t mediplus-app:jenkins .'
            }
        }
    }

    post {
        success {
            echo 'Mediplus pipeline completed successfully!'
        }

        failure {
            echo 'Mediplus pipeline failed. Check the console output.'
        }
    }
}
