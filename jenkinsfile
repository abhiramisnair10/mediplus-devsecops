
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out Mediplus from GitHub'
                checkout scm
            }
        }

      
stage('Prepare Shared Workspace') {
    steps {
        sh '''
            mkdir -p /workspace/mediplus-CI-CD
            cp -a "$WORKSPACE"/. /workspace/mediplus-CI-CD/
        '''
    }
}

stage('Python Dependency Installation') {
    steps {
        sh '''
            docker run --rm \
              -v /workspace/mediplus-CI-CD:/app \
              -w /app \
              python:3.11-slim \
              pip install -r requirements.txt
        '''
    }
}

       
stage('Dependency Scan - pip-audit') {
    steps {
        sh '''
            docker run --rm \
              -v /workspace/mediplus-CI-CD:/app \
              -w /app \
              python:3.11-slim \
              sh -c "pip install -r requirements.txt pip-audit && pip-audit"
        '''
    }
}

        stage('SAST - SonarQube') {
            steps {
                echo 'SonarQube integration pending'
            }
        }

        stage('DAST - OWASP ZAP') {
            steps {
                echo 'OWASP ZAP integration pending'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Mediplus application'

                sh 'docker build -t mediplus-app:latest .'
            }
        }
    }

    post {
        success {
            echo 'Mediplus pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
